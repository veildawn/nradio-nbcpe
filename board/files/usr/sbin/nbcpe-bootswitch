#!/bin/sh
# Safe Dual-OS boot target switcher for NRadio NBCPE (WT9111).
# The stock bootloader selects the boot slot from `boot_system` stored in the
# eMMC "u-boot-env" partition (512 KiB, standard U-Boot CRC32 layout):
#   boot_system=0 -> factory system  (kernel   + rootfs)
#   boot_system=1 -> second system   (kernel_2nd + rootfs_2nd, e.g. OpenWrt)
# The factory `ubenv` tool is reused verbatim so the on-flash format stays
# bit-compatible with the stock firmware; we refuse to write unless the
# environment lists the expected known-good variables.

set -u

UBENV=/usr/bin/ubenv
VAR="boot_system"

env_list() {
	"$UBENV" -o 3 2>/dev/null
}

env_get() {
	local out
	out=$("$UBENV" -o 1 -s "$VAR" 2>/dev/null) || return 1
	# The factory tool prints "boot_system = 0", not a bare value.
	printf '%s\n' "$out" | sed -n 's/^boot_system[[:space:]]*=[[:space:]]*\([01]\)[[:space:]]*$/\1/p'
}

env_sane() {
	local out
	out=$(env_list) || return 1
	[ -n "$out" ] || return 1
	printf '%s\n' "$out" | grep -qE '^boot_system=[01]$' || return 1
	printf '%s\n' "$out" | grep -qE '^baudrate=115200$' || return 1
	[ "$(printf '%s\n' "$out" | wc -l)" -ge 5 ] || return 1
	return 0
}

switch_target() {
	local want="$1" label="$2" cur got
	command -v "$UBENV" >/dev/null 2>&1 || { echo "ERROR: $UBENV not found" >&2; return 1; }
	[ -b "$(blkid -t PARTLABEL=u-boot-env -o device 2>/dev/null)" ] || {
		echo "ERROR: PARTLABEL=u-boot-env block device not found" >&2
		return 1
	}
	env_sane || { echo "ERROR: u-boot-env sanity check failed; refusing to write" >&2; return 1; }

	cur=$(env_get)
	case "$cur" in 0|1) ;; *) echo "ERROR: invalid boot_system; refusing to write." >&2; return 1 ;; esac
	if [ "$cur" = "$want" ]; then
		echo "$VAR is already $want ($label)."
		return 0
	fi
	"$UBENV" -o 0 -s "$VAR" -v "$want" >/dev/null 2>&1 || {
		echo "ERROR: ubenv write failed; recheck boot target before rebooting." >&2
		return 1
	}
	got=$(env_get)
	if [ "$got" != "$want" ]; then
		echo "ERROR: read-back mismatch (got '$got', expected '$want')." >&2
		return 1
	fi
	echo "Updated $VAR=$want ($label). Run 'reboot' to boot into $label."
	return 0
}

case "${1:-status}" in
status|check)
	command -v "$UBENV" >/dev/null 2>&1 || { echo "ERROR: $UBENV not found" >&2; exit 1; }
	cur=$(env_get)
	case "$cur" in
	1) desc="openwrt-second-system" ;;
	0) desc="factory-system" ;;
	*) echo "ERROR: could not read a valid boot_system." >&2; exit 1 ;;
	esac
	echo "${VAR}=${cur:-unset} (${desc})"
	;;
to-factory|to-official)
	switch_target 0 "factory system (onboard eMMC slot 0)"
	;;
to-openwrt|to-second)
	switch_target 1 "OpenWrt (eMMC second system)"
	;;
*)
	echo "Usage: $0 {status|check|to-factory|to-openwrt}" >&2
	exit 1
	;;
esac
